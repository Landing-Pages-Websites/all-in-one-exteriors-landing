# ------------------------------------------------------------------
# Tracking / verification env vars (Layer 3).
#
# ALL of these are OPTIONAL: the site builds and runs with none of
# them set — each loader renders nothing until its var exists.
# They are minted by the provisioning bot and set in Vercel env,
# not committed to the repo.
# ------------------------------------------------------------------

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Set by: provisioning bot. Loads gtag after cookie consent.
NEXT_PUBLIC_GA4_ID=

# NOTE: the Mega optimizer snippet needs no env var — it is hard-coded in
# src/components/analytics/MegaSnippet.tsx (and intentionally not
# consent-gated). Mega customer/site IDs for lead submission live in
# src/site.config.ts.

# PostHog project API key (e.g. phc_...). Set by: provisioning bot.
# Lazy-loads PostHog through the /ingest reverse proxy after consent.
# Session recording is disabled by default (enabled later per-site).
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API host. Set by: provisioning bot, ONLY for non-US projects.
# Defaults to https://us.i.posthog.com when unset.
NEXT_PUBLIC_POSTHOG_HOST=

# Google Search Console verification token (content of the meta tag).
# Set by: provisioning bot. Emitted via <meta name="google-site-verification">.
NEXT_PUBLIC_GSC_VERIFICATION=

# ------------------------------------------------------------------
# Lead-form protection. Provisioning mints a Cloudflare Turnstile
# widget and sets these in Vercel. Preview may use Cloudflare's
# always-pass dummy keys; production must not.
# ------------------------------------------------------------------

# Public widget sitekey. Dummy always-pass: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Siteverify secret. Dummy always-pass:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Comma-separated hostnames Siteverify may return. Production must not
# include localhost. Example: example.com,www.example.com
TURNSTILE_HOSTNAMES=

# ------------------------------------------------------------------
# Build-time flags
# ------------------------------------------------------------------

# Set to 1 to let `npm run build` continue while TODO_ sentinels remain
# in src/site.config.ts (check-config warns instead of failing).
# Use for preview builds only — never for the production deploy.
ALLOW_TODO=
