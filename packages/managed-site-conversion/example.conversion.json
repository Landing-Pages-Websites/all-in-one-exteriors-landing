    },

    "/admin": {
      "purpose": "other",
      "canonical": "https://www.example.com/admin",
      "sitemap": { "included": false, "changeFrequency": "never", "priority": 0 },
      "performanceBudget": {
        "maxLcpMilliseconds": 2500,
        "maxCls": 0.1,
        "maxInpMilliseconds": 200,
        "maxPageBytes": 2097152
      },
      "managedContent": false
    }
  },

  "text": {
    "labelMaxLength": 160,
    "bodyMaxLength": 1000,
    "headingMaxLength": 300,
    "linkLabelMaxLength": 160,
    "richTextMaxCharacters": 2000,
