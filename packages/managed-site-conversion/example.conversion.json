    "integrity": "sha384-/+5J7l1l8JNgnIgvgOqEHDgx92NrGmbjezpRb/MZb2y0RildsCcaOVu8+mLZbrmF",
    "crossOrigin": "anonymous",
    "load": "head_defer"
