---
import { managedSiteFieldAttributesV1 } from "@landing-pages-websites/managed-site-contract";

import ManagedLayout from "../layouts/ManagedLayout.astro";
import { managedAstroHome } from "../lib/managed-site";

const home = managedAstroHome;
---

<ManagedLayout pageId={home.pageId} seo={home.seo} jsonLd={home.jsonLd}>
  <header class="site-header shell" id="top">
    <a class="wordmark" href="/" aria-label={`${home.identity.displayName} home`}>
      <img src="/logo.png" alt="" width="40" height="40" />
      <span>{home.identity.displayName}</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow" {...managedSiteFieldAttributesV1(home.hero.eyebrow.fieldId)}>
        {home.hero.eyebrow.value}
      </p>
      <h1 {...managedSiteFieldAttributesV1(home.hero.title.fieldId)}>
        {home.hero.title.value}
      </h1>
      <p class="hero__description" {...managedSiteFieldAttributesV1(home.hero.description.fieldId)}>
        {home.hero.description.value}
      </p>
      <a class="text-link" href="#services">Read the field notes <span aria-hidden="true">↘</span></a>
    </div>
    <div class="hero__mark" {...managedSiteFieldAttributesV1(home.hero.image.fieldId)}>
      <span class="hero__number">No. 01</span>
      <img src={home.hero.image.src} alt={home.hero.image.alt} width="512" height="512" />
    </div>
  </section>

  <section class="services shell" id="services" aria-labelledby="services-heading">
    <div class="section-heading">
      <span>Selected work</span>
      <h2 id="services-heading" {...managedSiteFieldAttributesV1(home.services.heading.fieldId)}>
        {home.services.heading.value}
      </h2>
    </div>
    <div class="service-grid">
      {home.services.items.map((service, index) => (
        <article class="service-card">
          <a href={`/services/${service.slug}`}>
            <div class="service-card__index">0{index + 1}</div>
            <img src={service.image.src} alt="" width="512" height="512" loading="lazy" />
            <h3 {...managedSiteFieldAttributesV1(service.heading.fieldId, service.itemId)}>
              {service.heading.value}
            </h3>
            <p {...managedSiteFieldAttributesV1(service.summary.fieldId, service.itemId)}>
              {service.summary.value}
            </p>
            <span class="service-card__arrow" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-heading">
    <div class="contact__inner shell">
      <p class="eyebrow">Start with the small thing</p>
      <h2 id="contact-heading" {...managedSiteFieldAttributesV1(home.contact.heading.fieldId)}>
        {home.contact.heading.value}
      </h2>
      <div class="contact__details">
        <a href={`mailto:${home.identity.email}`}>{home.identity.email}</a>
        <a href={`tel:${home.identity.telephone}`}>{home.identity.telephone}</a>
      </div>
    </div>
  </section>

  <footer class="site-footer shell">
    <p>{home.identity.legalName}</p>
    <a href="#top">Back to top ↑</a>
  </footer>
</ManagedLayout>
